---
import type { CollectionEntry } from 'astro:content';
interface Props { posts: CollectionEntry<'blog'>[] }
const { posts } = Astro.props;
---
<div class="blog-grid">
  {posts.map(post => <article class="card blog-card">
    <span class="pill">{post.data.platform}</span>
    <h2><a href={`/blog/${post.id}`}>{post.data.title}</a></h2>
    <p>{post.data.description}</p>
    <a class="read" href={`/blog/${post.id}`} aria-label={`${post.data.platform} rehberini oku`}>Rehberi oku <span aria-hidden="true">↗</span></a>
  </article>)}
</div>
<style>
  .blog-grid { display:grid; grid-template-columns:repeat(auto-fit,minmax(min(100%,290px),1fr)); gap:24px; }
  .blog-card { padding:28px; display:flex; flex-direction:column; align-items:flex-start; gap:18px; }
  h2 { font-size:1.6rem; line-height:1.15; } h2 a { text-decoration:none; } h2 a:hover { text-decoration:underline; }
  p { color:var(--text-2); } .read { margin-top:auto; padding-top:8px; color:var(--accent-text); font-weight:700; text-underline-offset:4px; }
</style>
