---
import Kivirik, { type Pose } from '../Kivirik.astro';

const steps: { pose: Pose; title: string; text: string; alt: string }[] = [
  {
    pose: 'sec',
    title: 'Seç',
    text: 'Katalogdan servisini ve planını seç. Fiyat yazmak yok.',
    alt: 'Kıvırık elinde açık bir katalog tutuyor',
  },
  {
    pose: 'sor',
    title: 'Kıvırık sorar',
    text: 'Ödeme günün ne zaman, ne sıklıkla kullanıyorsun? Birkaç kısa soru, o kadar.',
    alt: 'Kıvırık’ın yanında bir konuşma balonu',
  },
  {
    pose: 'hatirlat',
    title: 'Hatırlat',
    text: 'Ödemeden önce haber veririm. İzin verirsen hatırlatma, cihazında bildirim olarak gelir.',
    alt: 'Kıvırık elinde çalan bir zil tutuyor',
  },
  {
    pose: 'zam',
    title: 'Zammı yakala',
    text: 'Fiyatlar resmi sayfalardan düzenli taranır; zam olunca listen kendiliğinden güncellenir.',
    alt: 'Kıvırık şaşkın yüzle büyüteçten bakıyor',
  },
  {
    pose: 'tasarruf',
    title: 'Tasarruf et',
    text: 'Aylık ve yıllık toplamını gör, kullanmadığın aboneliği fark et.',
    alt: 'Kıvırık mutlu, kâsesinin yanında bozuk paralar',
  },
];
---

<section id="nasil-calisir" class="steps section noodles" aria-labelledby="steps-title">
  <div class="wrap">
    <div class="section-head">
      <span class="pill">Nasıl çalışır?</span>
      <h2 id="steps-title">Beş adımda bütün aboneliklerin kâsede.</h2>
    </div>
  </div>
  <ol class="rail" tabindex="0" aria-label="Nasıl çalışır adımları, yatay kaydırılabilir">
    {
      steps.map((s, i) => (
        <li class="step card">
          <div class="art">
            <Kivirik pose={s.pose} label={s.alt} animate />
          </div>
          <div class="body">
            <span class="num" aria-hidden="true">{i + 1}</span>
            <div>
              <h3>{s.title}</h3>
              <p>{s.text}</p>
            </div>
          </div>
        </li>
      ))
    }
  </ol>
</section>

<style>
  .steps {
    background-color: var(--bg-warm);
  }
  .rail {
    --pad: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: min(80%, 300px);
    gap: 14px;
    margin: 0;
    padding: 4px var(--pad) 28px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--tel-koyu) transparent;
  }
  .rail:focus-visible {
    outline-offset: -3px;
  }
  @media (min-width: 1100px) {
    .rail {
      grid-auto-flow: row;
      grid-template-columns: repeat(5, 1fr);
      max-width: var(--max);
      margin-inline: auto;
      padding-inline: var(--gutter);
      overflow: visible;
    }
  }
  .step {
    scroll-snap-align: start;
    display: grid;
    grid-template-rows: auto 1fr;
    gap: 18px;
    padding: 12px 12px 22px;
  }
  .art {
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3;
    padding: 14px 18px 8px;
    border-radius: calc(var(--r-card) - 10px);
    background: var(--bg);
  }
  .art :global(.kivirik) {
    max-height: 100%;
  }
  .body {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding-inline: 6px;
  }
  .num {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    background: var(--ink);
    color: var(--safran);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.0625rem;
  }
  @media (prefers-color-scheme: dark) {
    .num {
      background: var(--safran);
      color: var(--ink);
    }
  }
  h3 {
    font-size: 1.375rem;
    margin: 4px 0 6px;
  }
  .body p {
    color: var(--text-2);
    font-size: 0.9688rem;
    line-height: 1.5;
  }
</style>
