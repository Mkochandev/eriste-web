---
import PhoneFrame from '../PhoneFrame.astro';

const screens = [
  {
    label: 'Abonelik listesi',
    caption: 'Bütün abonelikler tek listede',
    src: '/images/ekranlar/01-abonelik-listesi.png',
    alt: 'Eriste uygulamasında tüm aboneliklerin listelendiği ana ekran',
  },
  {
    label: 'Katalog',
    caption: 'Servisi ve planı seç',
    src: '/images/ekranlar/02-katalog.png',
    alt: 'Servis ve plan seçilen katalog ekranı',
  },
  {
    label: 'Kıvırık soruyor',
    caption: 'Birkaç kısa soru',
    src: '/images/ekranlar/03-kivirik-soruyor.png',
    alt: 'Kıvırık’ın abonelik eklerken kısa sorular sorduğu ekran',
  },
  {
    label: 'Zam kartı',
    caption: 'Zam olunca listende',
    src: '/images/ekranlar/04-zam-karti.png',
    alt: 'Bir aboneliğe gelen zammı gösteren kart',
  },
  {
    label: 'İptal Kartı',
    caption: 'İptal etmek bu kadar kolay mı!',
    src: '/images/ekranlar/05-toplam-gider.png',
    alt: 'Bir aboneliğin nasıl iptal edileceğini gösteren kart',
  },
];
---

<section class="section screens" aria-labelledby="screens-title">
  <div class="wrap">
    <div class="section-head">
      <span class="pill">Ekranlar</span>
      <h2 id="screens-title">Bir göz at.</h2>
    </div>
  </div>
  <ul class="strip" tabindex="0" aria-label="Uygulama ekranları, yatay kaydırılabilir">
    {
      screens.map((s, i) => (
        <li style={`--tilt: ${i % 2 ? 2 : -2}deg`}>
          <PhoneFrame label={s.label} src={s.src} alt={s.alt} />
          <span class="cap">{s.caption}</span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .screens {
    overflow: hidden;
  }
  .strip {
    --pad: max(var(--gutter), calc((100vw - var(--max)) / 2 + var(--gutter)));
    display: flex;
    gap: 22px;
    margin: 0;
    padding: 16px var(--pad) 32px;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--pad);
    overscroll-behavior-x: contain;
    scrollbar-width: thin;
    scrollbar-color: var(--placeholder-text) transparent;
  }
  .strip:focus-visible {
    outline-offset: -3px;
  }
  li {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 16px;
    scroll-snap-align: start;
  }
  li :global(.phone) {
    --pw: 200px;
    transform: rotate(var(--tilt));
    transition: transform 0.3s var(--ease);
  }
  li:hover :global(.phone) {
    transform: rotate(0deg) translateY(-4px);
  }
  .cap {
    max-width: 200px;
    text-align: center;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 0.9375rem;
  }
</style>
