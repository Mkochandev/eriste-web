---
import type { Soru } from '../data/sss';

interface Props {
  items: Soru[];
}
const { items } = Astro.props;
---

<div class="faq">
  {
    items.map((s) => (
      <details>
        <summary>
          <span>{s.q}</span>
          <svg class="chev" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <path d="M6 9l6 6 6-6" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </summary>
        <p set:html={s.a} />
      </details>
    ))
  }
</div>

<style>
  .faq {
    display: grid;
    gap: 10px;
  }
  details {
    background: var(--card);
    border-radius: var(--r-card-sm);
    box-shadow: var(--shadow);
  }
  summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 18px 20px;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.0625rem;
    line-height: 1.3;
    letter-spacing: -0.01em;
    border-radius: var(--r-card-sm);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  .chev {
    flex: none;
    color: var(--text-2);
    transition: transform 0.25s var(--ease);
  }
  details[open] .chev {
    transform: rotate(180deg);
  }
  details p {
    padding: 0 20px 20px;
    color: var(--text-2);
  }
  details p :global(a) {
    color: var(--accent-text);
    font-weight: 600;
  }
  details p :global(strong) {
    color: var(--text);
  }
</style>
