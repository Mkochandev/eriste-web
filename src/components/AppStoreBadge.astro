---
import { APP_STORE_URL } from '../config';

interface Props {
  size?: 'md' | 'lg';
}
const { size = 'md' } = Astro.props;
---

{/* TODO: Apple'ın resmi "App Store'dan İndirin" rozeti (açık/koyu) public/ altına gelince onunla değiştir. */}
<a class:list={['badge', size]} href={APP_STORE_URL} rel="noopener" aria-label="erişte'yi App Store'dan ücretsiz indir">
  <svg viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
    <rect x="6" y="2" width="12" height="20" rx="3" fill="none" stroke="currentColor" stroke-width="2" />
    <path d="M10 18.5h4" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
  </svg>
  <span>
    <small>Ücretsiz indir</small>
    App Store'dan indir
  </span>
</a>

<style>
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    min-height: 56px;
    padding: 10px 22px 10px 18px;
    border-radius: 16px;
    background: var(--btn-bg);
    color: var(--btn-text);
    font-family: var(--font-display);
    font-weight: 800;
    font-size: 1.125rem;
    line-height: 1.1;
    text-decoration: none;
    letter-spacing: -0.01em;
  }
  .badge span {
    display: grid;
  }
  .badge small {
    font-weight: 700;
    font-size: 0.75rem;
    letter-spacing: 0.02em;
    opacity: 0.8;
  }
  .badge.lg {
    min-height: 64px;
    font-size: 1.25rem;
    padding-inline: 20px 26px;
  }
  a.badge {
    transition: transform 0.2s var(--ease);
  }
  a.badge:hover {
    transform: translateY(-2px);
  }
</style>
