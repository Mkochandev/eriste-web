---
import Logo from './Logo.astro';

const isHome = Astro.url.pathname === '/';
---

<header class="site-header on-dark">
  <div class="wrap bar">
    <a href="/" class="home" aria-label="erişte ana sayfa">
      <Logo class="header-logo" />
    </a>
    <nav aria-label="Ana menü">
      <a href="/destek" class="nav-link">Destek</a>
      <a href={isHome ? '#indir' : '/#indir'} class="btn btn-sm">İndir</a>
    </nav>
  </div>
</header>

<style>
  .site-header {
    position: relative;
    z-index: 10;
  }
  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    min-height: 68px;
  }
  .home {
    display: block;
    border-radius: 8px;
  }
  .home :global(.header-logo) {
    width: 92px;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .nav-link {
    padding: 10px 14px;
    border-radius: var(--r-pill);
    color: var(--text-2);
    font-family: var(--font-display);
    font-weight: 700;
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav-link:hover {
    color: var(--text);
  }
  .btn-sm {
    min-height: 40px;
    padding: 8px 18px;
    font-size: 0.9375rem;
  }
</style>
