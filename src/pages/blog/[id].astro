---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlogCards from '../../components/BlogCards.astro';
import { publishedPosts, formatDate, jsonLd } from '../../lib/blog';
import { SITE_URL } from '../../config';
export async function getStaticPaths() {
  return (await publishedPosts()).map(post => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content, headings } = await render(post);
const related = (await publishedPosts()).filter(p => post.data.related.includes(p.id));
const url = `${SITE_URL}/blog/${post.id}`;
const structured = { '@context':'https://schema.org', '@graph': [
  { '@type':'BlogPosting', headline:post.data.title, description:post.data.description, mainEntityOfPage:url,
    datePublished:post.data.published.toISOString(), dateModified:post.data.updated.toISOString(), inLanguage:'tr-TR',
    image:`${SITE_URL}/images/og.png`, author:{ '@type':'Organization', name:'erişte', url:`${SITE_URL}/blog/yayin-ilkeleri` },
    publisher:{ '@type':'Organization', name:'erişte', url:SITE_URL }, citation:post.data.sources.map(s=>s.url) },
  { '@type':'BreadcrumbList', itemListElement:[['Ana sayfa',SITE_URL],['Blog',`${SITE_URL}/blog`],[post.data.title,url]].map(([name,item],i)=>({ '@type':'ListItem', position:i+1, name, item })) }
] };
---
<BaseLayout title={post.data.title} description={post.data.description} ogType="article">
  <Fragment slot="head">
    <meta property="article:published_time" content={post.data.published.toISOString()} />
    <meta property="article:modified_time" content={post.data.updated.toISOString()} />
    <script type="application/ld+json" set:html={jsonLd(structured)} />
  </Fragment>
  <header class="article-head"><div class="wrap narrow">
    <nav aria-label="İçerik yolu"><a href="/">Ana sayfa</a> / <a href="/blog">Blog</a> / <span>{post.data.platform}</span></nav>
    <span class="pill">{post.data.platform} · İptal ve iade</span>
    <h1>{post.data.title}</h1>
    <p class="meta"><a href="/blog/yayin-ilkeleri">erişte</a> · Yayın: <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time><br />Kaynak kontrolü: <time datetime={post.data.updated.toISOString()}>{formatDate(post.data.updated)}</time></p>
    <p class="answer">{post.data.summary}</p>
  </div></header>
  <div class="wrap narrow article-body">
    <nav class="toc card" aria-label="Bu rehberde"><strong>Bu rehberde</strong><ul>{headings.filter(h=>h.depth===2).map(h=><li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></nav>
    <article class="prose"><Content /></article>
    <aside class="sources card" aria-label="Resmî kaynaklar"><h2>Resmî kaynaklar</h2><ul>{post.data.sources.map(s=><li><a href={s.url}>{s.title}</a></li>)}</ul><p>Menüler ve koşullar değişebilir. İşlem sırasında hesabındaki güncel bilgileri kontrol et. erişte bu platformların resmî destek kanalı değildir.</p></aside>
    <aside class="cta"><h2>Sıradaki yenilemeyi gözden kaçırma.</h2><p>Aboneliklerini tek listede görmek için <a href="/">erişte abonelik takibi uygulamasını</a> incele. İptal ve iade işlemini ilgili sağlayıcıda tamamlamalısın.</p><a class="btn" href="/#indir">erişte’yi keşfet</a></aside>
  </div>
  {related.length > 0 && <section class="wrap related"><h2>İlgili rehberler</h2><BlogCards posts={related} /></section>}
</BaseLayout>
<style>
 .narrow { max-width:800px; } .article-head { background:var(--bg-warm); padding-block:40px 48px; }
 .article-head .wrap { display:grid; gap:22px; justify-items:start; } nav,.meta { color:var(--text-2); font-size:.9rem; }
 h1 { font-size:clamp(2.3rem,7vw,3.8rem); line-height:1.08; } .answer { font-size:1.15rem; border-left:4px solid var(--safran); padding-left:20px; }
 .article-body { padding-block:32px 60px; } .toc,.sources { padding:24px; } .toc ul { margin-bottom:0; } li { margin-block:8px; }
 a { text-underline-offset:4px; overflow-wrap:anywhere; } .prose { font-size:1.08rem; line-height:1.8; }
 .prose :global(h2) { margin:42px 0 18px; font-size:1.8rem; line-height:1.2; } .prose :global(h3) { margin:28px 0 12px; font-size:1.3rem; }
 .prose :global(p),.prose :global(ul),.prose :global(ol) { margin:0 0 20px; } .prose :global(a) { color:var(--accent-text); text-underline-offset:4px; }
 .prose :global(li) { margin-block:8px; } .prose :global(blockquote) { margin:24px 0; padding:20px; background:var(--pill-bg); border-radius:16px; }
 .sources { margin-top:36px; } .sources h2,.cta h2 { font-size:1.5rem; line-height:1.2; } .sources p { color:var(--text-2); font-size:.9rem; }
 .cta { margin-top:32px; display:grid; gap:18px; justify-items:start; } .related { padding-bottom:80px; } .related > h2 { margin-bottom:24px; font-size:2rem; }
</style>
